Model Testing/data/
*.wav

# ==========================================
# Training outputs
# ==========================================
# 30 cross-validation checkpoints (keep only the summary CSVs)
Model Testing/experiments/runs/
# Keep the 3 final checkpoints (~400 KB each) so the project runs without retraining:
#   checkpoints/pretrain_best.pt, drywet_finetune_best.pt, drywet_scratch_best.pt
# Ignore any other large model files that may appear later
*.pth
*.ckpt
*.onnx

# Export folder is regenerated by `python src/export.py` (app copy in Final Project/app is kept)
Model Testing/exports/

# ==========================================
# File Log, Dokumen, dan Output Gambar (Opsional - Dari Proyekmu)
# ==========================================
*.log
*.docx
Claude outputs/

